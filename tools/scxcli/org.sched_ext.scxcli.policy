<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  polkit actions for scxcli, told apart by the first argument. pkexec
  matches org.freedesktop.policykit.exec.path and .argv1, so an action
  covers exactly one subcommand and scxcli's own parser decides what
  that subcommand accepts.

  Install as /usr/share/polkit-1/actions/org.sched_ext.scxcli.policy.
  A distribution that wants every action to need a password ships a
  stricter file or none; scxcli then works only as root.
-->
<policyconfig>
  <vendor>sched_ext</vendor>
  <vendor_url>https://github.com/sched-ext/scx</vendor_url>

  <action id="org.sched_ext.scxcli.apply">
    <description>Apply a sched_ext scheduling profile</description>
    <message>Authentication is required to apply a scheduling profile</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/scxcli</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apply</annotate>
  </action>

  <action id="org.sched_ext.scxcli.profiles">
    <description>Change the sched_ext scheduling profile list</description>
    <message>Authentication is required to change the scheduling profiles</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/scxcli</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">profiles</annotate>
  </action>

  <action id="org.sched_ext.scxcli.run">
    <description>Start a sched_ext scheduler with arbitrary options</description>
    <message>Authentication is required to start a scheduler outside a profile</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/scxcli</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">run</annotate>
  </action>
</policyconfig>
