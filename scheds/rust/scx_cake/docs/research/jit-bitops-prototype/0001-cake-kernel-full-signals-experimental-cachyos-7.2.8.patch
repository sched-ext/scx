+		opcode = 0xbc;
+	else if (func == (const u8 *)bpf_popcnt64 && boot_cpu_has(X86_FEATURE_POPCNT))
+		opcode = 0xb8;
+	else if (func == (const u8 *)bpf_clz64 && boot_cpu_has(X86_FEATURE_ABM))
+		opcode = 0xbd;
+	else
