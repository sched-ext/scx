+		if (bpf_ctz64(bit) != i || bpf_popcnt64(bit) != 1 ||
+		    bpf_popcnt64(~bit) != 63 || bpf_clz64(bit) != 63 - i ||
+		    bpf_mulhi64(bit, ~0ULL) != bit - 1)
+			return 2;
+	}
+	return 0;
