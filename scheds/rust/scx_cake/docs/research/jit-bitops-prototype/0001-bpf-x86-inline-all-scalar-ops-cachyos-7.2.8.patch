diff --git a/tools/testing/selftests/bpf/progs/scalar_bitops.c b/tools/testing/selftests/bpf/progs/scalar_bitops.c
new file mode 100644
--- /dev/null
+++ b/tools/testing/selftests/bpf/progs/scalar_bitops.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/bpf.h>
+#include <bpf/bpf_helpers.h>
+#include "bpf_misc.h"
+
+extern __u64 bpf_ctz64(__u64 x) __ksym;
+extern __u64 bpf_popcnt64(__u64 x) __ksym;
+extern __u64 bpf_clz64(__u64 x) __ksym;
+extern __u64 bpf_mulhi64(__u64 x, __u64 y) __ksym;
+
+static __always_inline __u64 mulhi_ref(__u64 x, __u64 y)
+{
+	__u64 x0 = (__u32)x, x1 = x >> 32, y0 = (__u32)y, y1 = y >> 32;
+	__u64 mid = x1 * y0 + ((x0 * y0) >> 32);
+	__u64 carry = mid >> 32;
+
+	asm volatile("" : "+r" (carry));
+	mid = (__u32)mid + x0 * y1;
+	return x1 * y1 + carry + (mid >> 32);
+}
+
+SEC("syscall")
+__success __retval(0)
+int scalar_bitops_boundaries(void *ctx)
+{
+	int i;
+
+	if (bpf_ctz64(0) != 64 || bpf_popcnt64(0) != 0 ||
+	    bpf_ctz64(~0ULL) != 0 || bpf_popcnt64(~0ULL) != 64 ||
+	    bpf_clz64(0) != 64 || bpf_clz64(~0ULL) != 0 ||
+	    bpf_mulhi64(0, ~0ULL) != 0 ||
+	    bpf_mulhi64(~0ULL, ~0ULL) != ~0ULL - 1)
+		return 1;
+	for (i = 0; i < 64; i++) {
+		__u64 bit = 1ULL << i;
+
+		if (bpf_ctz64(bit) != i || bpf_popcnt64(bit) != 1 ||
+		    bpf_popcnt64(~bit) != 63 || bpf_clz64(bit) != 63 - i ||
+		    bpf_mulhi64(bit, ~0ULL) != bit - 1)
+			return 2;
+	}
+	return 0;
+}
+
+SEC("syscall")
+__success __retval(0)
+int scalar_bitops_random(void *ctx)
+{
+	__u64 x = 0xd1b54a32d192ed03ULL;
+	int i;
+
+	for (i = 0; i < 1024; i++) {
+		x ^= x << 13;
+		x ^= x >> 7;
+		x ^= x << 17;
+		if (bpf_ctz64(x) != (x ? __builtin_ctzll(x) : 64) ||
+		    bpf_popcnt64(x) != __builtin_popcountll(x) ||
+		    bpf_clz64(x) != (x ? __builtin_clzll(x) : 64) ||
+		    bpf_mulhi64(x, ~x) != mulhi_ref(x, ~x))
+			return 1;
+	}
+	return 0;
+}
+
+SEC("syscall")
+__success __retval(0)
+__naked int scalar_bitops_preserve(void)
+{
+	asm volatile (
+		"r6 = 17; r7 = 29; r8 = 43; r9 = 61;"
+		"r1 = 256; call bpf_ctz64;"
+		"if r0 != 8 goto fail_%=;"
+		"if r6 != 17 goto fail_%=;"
+		"if r7 != 29 goto fail_%=;"
+		"if r8 != 43 goto fail_%=;"
+		"if r9 != 61 goto fail_%=;"
+		"r1 = -1; call bpf_popcnt64;"
+		"if r0 != 64 goto fail_%=;"
+		"if r6 != 17 goto fail_%=;"
+		"if r7 != 29 goto fail_%=;"
+		"if r8 != 43 goto fail_%=;"
+		"if r9 != 61 goto fail_%=;"
+		"r1 = 256; call bpf_clz64;"
+		"if r0 != 55 goto fail_%=;"
+		"if r6 != 17 goto fail_%=;"
+		"if r7 != 29 goto fail_%=;"
+		"if r8 != 43 goto fail_%=;"
+		"if r9 != 61 goto fail_%=;"
+		"r1 = -1; r2 = -1; call bpf_mulhi64;"
+		"if r0 != -2 goto fail_%=;"
+		"if r6 != 17 goto fail_%=;"
+		"if r7 != 29 goto fail_%=;"
+		"if r8 != 43 goto fail_%=;"
+		"if r9 != 61 goto fail_%=;"
+		"r0 = 0; exit;"
+		"fail_%=: r0 = 1; exit;"
+		::: __clobber_all);
+}
