@@ -117,6 +117,7 @@ UEI_DEFINE(uei);
 
 /* Declared ahead of the toggle block: the probe census below reads it. */
 const volatile u8 cake_tog_probe;		/* diagnostics: placement census, hold attribution, black box (--toggle probe=1) */
+const volatile u8 cake_tog_sibwake;		/* same-process wake → waker's idle SMT sibling (--toggle sibwake=1) */
 
 /* PROBE placement census for ops.select_cpu, not for scoring: per-CPU map,
  * plain increment on this CPU's copy, no atomic, no shared line. */
@@ -238,6 +239,7 @@ enum cake_stat {
 	CAKE_SITE_PEND_HEAL,		/* unserved reset under a zero token: pops the serve never saw */
 	CAKE_SITE_RELEASE_SERVE,	/* cpu_release found own-queue work and kicked an idle CPU */
 	CAKE_SITE_PINNED_PREEMPT,	/* pinned wake preempted the occupant on its insert */
+	CAKE_SITE_SIB_WAKE,		/* same-process wake placed on the waker's SMT sibling */
 	CAKE_STAT_NR,
 };
 
@@ -2040,6 +2042,24 @@ s32 BPF_STRUCT_OPS(cake_select_cpu, struct task_struct *p, s32 prev_cpu,
 		}
 	}
 
+	/* sibwake: a thread waking another of its own process shares data with it;
+	 * the waker's idle SMT sibling shares its L1/L2. Not from a handler: the
+	 * current task there is whoever the interrupt hit. */
+	if (cake_tog_sibwake) {
+		u32 wc = bpf_get_smp_processor_id() & (MAX_CPUS - 1);
+		struct task_struct *cur = bpf_get_current_task_btf();
+		s32 sib = cpu_sibling[wc];
+
+		if (sib >= 0 && sib < 64 && cur != p && cur->mm && cur->mm == p->mm &&
+		    !cake_irq_live[wc].depth && cake_allowed(p, sib) &&
+		    !cake_cpu_irq_bad(sib) && cake_taci(sib, CAKE_SITE_TACI_WARM)) {
+			cake_stat_inc(CAKE_SITE_SIB_WAKE);
+			c = sib;
+			flags = CAKE_ENQ_IMMED;
+			goto place;
+		}
+	}
+
 	/* One whole-core snapshot serves the home test and the warm claim's core
 	 * preference; the atomic claim still decides admission. */
 	if (cake_one_word)
