 #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, clap::ValueEnum)]
 enum KernelSignals {
@@ -559,7 +562,7 @@ impl<'a> Scheduler<'a> {
 
         // Campaign toggles land in rodata before load so the verifier prunes the off
